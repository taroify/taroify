{
  "name": "@taroify/cli",
  "version": "1.0.4",
  "description": "Taroify 面向 AI Coding 的离线组件知识 CLI 与 MCP Server",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "taroify",
    "taro",
    "cli",
    "mcp",
    "ai-coding",
    "react-components"
  ],
  "homepage": "https://taroify.com/cli/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taroify/taroify.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/taroify/taroify/issues/new"
  },
  "bin": {
    "taroify": "dist/cli.js"
  },
  "exports": {
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "files": [
    "dist",
    "data",
    "skills",
    "README.md"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepare-data": "node scripts/prepare-data.mjs",
    "build": "node scripts/prepare-data.mjs && tsup",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/prepare-data.mjs && tsup && node --test tests/cli.test.mjs tests/data.test.mjs tests/mcp.test.mjs",
    "test:pack": "node --test tests/pack.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  }
}
