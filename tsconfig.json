{
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "dist",
    "sourceMap": false,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "allowJs": false,
    "strict": true,
    "noUnusedLocals": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "removeComments": true,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "types": ["jest", "node"],
    "rootDir": ".",
    "jsx": "react",
    "typeRoots": ["node_modules/@types"],
    "paths": {
      "@taroify/commerce": ["packages/commerce/src/index.ts"],
      "@taroify/commerce/*": ["packages/commerce/src/*"],
      "@taroify/core": ["packages/core/src/index.ts"],
      "@taroify/core/*": ["packages/core/src/*"],
      "@taroify/hooks": ["packages/hooks/src/index.ts"],
      "@taroify/hooks/*": ["packages/hooks/src/*"],
      "@taroify/icons": ["packages/icons/src/index.ts"],
      "@taroify/icons/*": ["packages/icons/src/*"]
    }
  },
  "include": ["packages/*/src", "jest/jest-setup.ts", "typings.d.ts"],
  "exclude": ["node_modules", "packages/cli"]
}
