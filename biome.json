{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/*.svg",
      "!**/packages/demo",
      "!**/packages/cli/meta",
      "!**/site/theme/styles/taroify-core.css"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "linter": {
    "rules": {
      "style": {
        "noNonNullAssertion": "off",
        "useConst": "warn",
        "useTemplate": "warn",
        "useImportType": {
          "level": "warn",
          "fix": "none"
        },
        "noParameterAssign": "warn",
        "useNumberNamespace": "warn",
        "useSingleVarDeclarator": "warn",
        "noUnusedTemplateLiteral": "warn"
      },
      "correctness": {
        "useHookAtTopLevel": "warn",
        "useExhaustiveDependencies": "warn",
        "noUnsafeOptionalChaining": "warn",
        "noChildrenProp": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noAssignInExpressions": "warn",
        "noRedundantUseStrict": "warn",
        "noConfusingVoidType": "warn",
        "noImplicitAnyLet": "warn",
        "noTsIgnore": {
          "level": "warn",
          "fix": "none"
        },
        "noNonNullAssertedOptionalChain": "off",
        "useIterableCallbackReturn": {
          "level": "error",
          "options": {
            "checkForEach": false
          }
        }
      },
      "complexity": {
        "useLiteralKeys": "warn",
        "noForEach": "warn"
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "formatter": {
    "lineWidth": 100,
    "indentStyle": "space"
  },
  "json": {
    "parser": {
      "allowComments": true
    }
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "semicolons": "asNeeded"
    }
  }
}
